# Copy to .env (scripts) and .env.app (Flutter build). Both are git-ignored.
# .env.app must not contain LOCAL_ADMIN_PASSWORD.
DB_TARGET=neon
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
LOCAL_DATABASE_URL=postgresql://enrollment_dev:PASSWORD@localhost:5432/enrollment_local
# .env only
LOCAL_ADMIN_PASSWORD=
